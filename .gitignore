# Python virtual environment / cache
venv/
__pycache__/
*.pyc
.pytest_cache/

# Training data and tokenization cache — generated by scripts, not to be committed
kaggle/corpus_logic.txt
*.ids.npy
*.txt.cache

# Model checkpoints — large binary files, keep on HF Hub / Kaggle Datasets, not in git
checkpoints/
*.pt
*.safetensors

# Cache of downloaded backbone weights
backbone_cache/

# Temporary configs generated while debugging
configs/*_smoketest.yaml
configs/*_batchtest.yaml

# Secrets — never commit tokens
.env
*.token
